<!DOCTYPE html><html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><link rel="stylesheet" type="text/css" href="cid:css-cecf25ce-f843-4e5a-8b14-4ec1ed5f284d@mhtml.blink" /><link rel="stylesheet" type="text/css" href="cid:css-e6652090-2548-423f-b553-e748f3dc222e@mhtml.blink" />

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SnapStudy V3 - Photo to Flashcards | By Mary</title>


<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@700;800&amp;family=Inter:wght@400;500;600&amp;display=swap" rel="stylesheet">

</head>
<body class="pb-24">
<header class="bg-white border-b sticky top-0 z-30">
<div class="max-w-5xl mx-auto px-4 py-3 flex justify-between items-center">
<div class="flex items-center gap-2">
<div class="w-10 h-10 bg-[#7c3aed] rounded-xl flex items-center justify-center text-white font-black">S</div>
<div class="leading-none"><div class="font-extrabold">SnapStudy <span class="bg-[#ede9fe] text-[#7c3aed] text-[10px] px-2 py-1 rounded-full">V3 PHOTO</span></div><div class="text-[10px] text-gray-500">BY MARYVIN2018</div></div>
</div>
<div class="flex gap-2">
<span id="modeBadge" class="text-[10px] px-2 py-1 rounded-full bg-green-100 text-green-700 font-bold hidden md:block">ADMIN</span>
<button id="modeBtn" class="text-[11px] bg-gray-900 text-white px-3 py-2 rounded-full font-bold">Student View</button>
</div>
</div>
</header>

<div class="max-w-5xl mx-auto px-4 mt-4 space-y-4">
<!-- HERO -->
<div class="bg-gradient-to-br from-[#7c3aed] to-[#4f46e5] rounded-[28px] p-6 text-white">
<h1 class="text-[28px] font-extrabold leading-[1.1]">Snap Photo → Ace Exam.</h1>
<p class="mt-2 text-white/80 text-[13px]">For Nigerian students. Take photo of notebook, textbook, or blackboard → Get flashcards instantly. No typing!</p>
<div class="mt-3 flex gap-2"><span class="bg-white/20 px-3 py-1 rounded-full text-[10px]">📸 Photo to Text</span><span class="bg-white/20 px-3 py-1 rounded-full text-[10px]">⚡ Auto Flashcards</span><span class="bg-white/20 px-3 py-1 rounded-full text-[10px]">🎬 TikTok Script</span></div>
</div>

<!-- SEARCH -->
<div class="bg-white rounded-2xl p-3 border shadow-sm flex items-center gap-2">
<span>🔍</span>
<input id="searchInput" placeholder="Search flashcards... e.g. Photosynthesis, 2x, Achebe" class="flex-1 outline-none text-[14px]">
<button class="text-[11px] text-gray-400">Clear</button>
</div>

<!-- TABS -->
<div class="flex gap-2">
<button id="tabAI" class="flex-1 bg-[#7c3aed] text-white py-3 rounded-2xl font-bold text-[13px]">📸 AI Studio</button>
<button id="tabDeck" class="flex-1 bg-white border py-3 rounded-2xl font-bold text-[13px]">📚 Deck (<span id="deckCount">2</span>)</button>
</div>

<!-- AI STUDIO -->
<div id="aiPanel" class="space-y-4">
<!-- PHOTO UPLOAD - NEW! -->
<div class="bg-white rounded-[20px] p-5 border shadow-sm">
<h2 class="font-extrabold text-[16px] mb-1">📸 Step 1: Snap or Upload Note Photo</h2>
<p class="text-[12px] text-gray-500 mb-3">Take photo of your handwritten note, textbook page, or blackboard. No need to type!</p>

<div id="uploadArea" class="upload-area rounded-2xl p-6 text-center cursor-pointer">
<div id="uploadPlaceholder">
<div class="text-4xl mb-2">📷</div>
<p class="font-bold text-[14px] text-[#7c3aed]">Tap to Take Photo or Upload</p>
<p class="text-[11px] text-gray-500 mt-1">Supports JPG, PNG - Your notebook, textbook</p>
<button class="mt-3 bg-[#7c3aed] text-white px-5 py-2 rounded-full text-[12px] font-bold">Open Camera / Gallery</button>
</div>
<img id="previewImg" class="hidden w-full max-h-64 object-contain rounded-xl mx-auto">
</div>
<input type="file" id="photoInput" accept="image/*" capture="environment" class="hidden">

<div id="photoActions" class="hidden mt-3 grid grid-cols-2 gap-2">
<button id="extractBtn" class="bg-black text-white py-3 rounded-xl font-bold text-[13px]">🔍 Extract Text from Photo</button>
<button class="bg-gray-100 py-3 rounded-xl font-bold text-[13px]">🗑️ Remove Photo</button>
</div>

<div id="ocrStatus" class="hidden mt-3 bg-amber-50 border border-amber-200 rounded-xl p-3 text-[12px] text-center">⏳ Reading your photo... 0%</div>

</div>

<!-- TEXT AREA -->
<div class="bg-white rounded-[20px] p-5 border shadow-sm">
<h2 class="font-extrabold text-[16px] mb-2">📝 Step 2: Edit Text (or Paste Directly)</h2>
<textarea id="lessonInput" rows="4" placeholder="After photo extraction, text will appear here... Or paste directly:

Example: Photosynthesis is how plants make food using sunlight. It happens in chloroplast. Needs sunlight, water, CO2..." class="w-full border rounded-xl p-3 text-[13px] outline-none focus:border-[#7c3aed]"></textarea>
<div class="grid grid-cols-3 gap-2 mt-3">
<button class="bg-gray-900 text-white py-3 rounded-xl font-bold text-[12px]">📝 Summary</button>
<button class="bg-[#7c3aed] text-white py-3 rounded-xl font-bold text-[12px]">⚡ Flashcards</button>
<button class="bg-black text-white py-3 rounded-xl font-bold text-[12px]">🎬 TikTok</button>
</div>
<p class="text-[10px] text-gray-400 mt-2">Tip: For photo, first extract text, then click Flashcards!</p>
</div>

<!-- RESULTS -->
<div id="results" class="hidden grid md:grid-cols-3 gap-3">
<div class="bg-white rounded-2xl p-4 border"><h3 class="font-bold text-[13px] mb-2">📝 Summary</h3><p id="summaryOut" class="text-[12px] text-gray-700"></p><button class="mt-2 text-[10px] bg-gray-100 px-2 py-1 rounded-full">Copy</button></div>
<div class="bg-white rounded-2xl p-4 border"><h3 class="font-bold text-[13px] mb-2">⚡ Flashcards</h3><div id="genCards" class="space-y-2 max-h-60 overflow-auto"></div><button class="mt-2 w-full bg-[#7c3aed] text-white py-2 rounded-xl text-[11px] font-bold">+ Add All to Deck</button></div>
<div class="bg-white rounded-2xl p-4 border"><h3 class="font-bold text-[13px] mb-2">🎬 TikTok Script</h3><p id="tiktokOut" class="text-[11px] whitespace-pre-line"></p><button class="mt-2 text-[10px] bg-gray-100 px-2 py-1 rounded-full">Copy</button></div>
</div>

<!-- MANUAL -->
<div id="manualCreate" class="bg-white rounded-[20px] p-5 border">
<h2 class="font-bold text-[14px] mb-2">Manual Create (Admin)</h2>
<input id="qInput" placeholder="Question: What is 2x=10?" class="w-full border rounded-xl p-3 mb-2 text-[13px]">
<input id="aInput" placeholder="Answer: x=5" class="w-full border rounded-xl p-3 mb-2 text-[13px]">
<button class="w-full bg-[#7c3aed] text-white py-3 rounded-xl font-bold text-[13px]">Save Card → Deck</button>
</div>
</div>

<!-- DECK -->
<div id="deckPanel" class="hidden space-y-3">
<div class="flex justify-between items-center"><h2 class="font-bold">Study Deck</h2><button class="bg-black text-white px-4 py-2 rounded-full text-[11px] font-bold">🎯 Cram Mode</button></div>
<div id="cardsList" class="grid gap-3"><div class="bg-white rounded-2xl p-4 border"><div class="text-[10px] text-[#7c3aed] font-bold">CARD 1</div><div class="font-bold text-[15px]">What is 2x = 10?</div><div class="text-[13px] text-gray-600 mt-1">x = 5</div><button class="mt-2 text-[10px] bg-red-50 text-red-600 px-2 py-1 rounded-full">Delete</button></div><div class="bg-white rounded-2xl p-4 border"><div class="text-[10px] text-[#7c3aed] font-bold">CARD 2</div><div class="font-bold text-[15px]">Who wrote Things Fall Apart?</div><div class="text-[13px] text-gray-600 mt-1">Chinua Achebe</div><button class="mt-2 text-[10px] bg-red-50 text-red-600 px-2 py-1 rounded-full">Delete</button></div></div>
</div>

<div id="studentBanner" class="hidden bg-amber-100 border rounded-2xl p-4 text-center text-[12px]"><b>👩‍🎓 Student View:</b> Search &amp; Study only. Only Mary can create.</div>
</div>

<!-- CRAM -->
<div id="cramModal" class="fixed inset-0 bg-black/80 z-50 hidden flex items-center justify-center p-6">
<div class="bg-white rounded-[24px] max-w-md w-full p-6">
<div class="flex justify-between mb-4"><span class="font-bold">Cram</span><button class="bg-gray-100 w-8 h-8 rounded-full">✕</button></div>
<div id="cramCard" class="flip-card relative h-56 cursor-pointer"><div class="flip-inner relative w-full h-full"><div class="flip-front bg-[#ede9fe] rounded-2xl p-6 flex items-center justify-center text-center font-bold" id="cramFront"></div><div class="flip-back bg-[#7c3aed] text-white rounded-2xl p-6 flex items-center justify-center text-center" id="cramBack"></div></div></div>
<div class="flex justify-between mt-4"><button class="px-4 py-2 bg-gray-100 rounded-full text-[11px]">Prev</button><span id="cramProgress" class="text-[11px] py-2"></span><button class="px-4 py-2 bg-black text-white rounded-full text-[11px]">Next</button></div>
</div>
</div>




</body></html>
